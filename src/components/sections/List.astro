---
import type { Section } from "@/data/types";
import Section_ from "./Section.astro";
type P = Extract<Section, { type: "list" }>;
const s = Astro.props as P;
const twoCol = s.items.length >= 8 && Math.max(...s.items.map((i) => i.length)) < 120;
---
<Section_ narrow>
  {s.image?.src && <img src={s.image.src} alt={s.image.alt ?? ""} class="mb-10 aspect-[21/9] w-full rounded-ui object-cover" loading="lazy" />}
  {s.title && <h2 class="mb-6 text-3xl font-extrabold tracking-tight md:text-4xl">{s.title}</h2>}
  {s.paragraphs?.length && <div class="prose-measure text-lg leading-relaxed text-ink-soft">{s.paragraphs.map((p) => <p>{p}</p>)}</div>}
  <div class:list={["mt-8", s.listTitle && "list-band"]}>
    {s.listTitle && <p class="list-title text-lg font-bold">{s.listTitle}</p>}
    <ul class:list={["mt-4 space-y-2", twoCol && "md:columns-2 md:gap-10"]}>
      {s.items.map((it) => <li class="flex gap-3 break-inside-avoid leading-relaxed"><span aria-hidden="true" class="bullet mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span><span>{it}</span></li>)}
    </ul>
  </div>
  {s.outro && <p class="prose-measure mt-8 text-lg leading-relaxed">{s.outro}</p>}
  {s.cta && <a href={s.cta.href} class="mt-8 inline-block rounded-ui bg-accent px-6 py-3 font-bold text-accent-ink">{s.cta.label}</a>}
</Section_>
