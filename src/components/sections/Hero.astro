---
import type { Section } from "@/data/types";
type P = Extract<Section, { type: "hero" }> & { layout?: { hero?: string } };
const s = Astro.props as P;
const hasImg = !!s.image?.src;
// split (implicit) · cover = poză pe tot ecranul, text peste · centered = text centrat, poza lată dedesubt
let mode = s.layout?.hero ?? "split";
if (mode === "cover" && !hasImg) mode = "centered";
---
{mode === "cover" ? (
  <section class="hero-cover relative isolate flex min-h-[82vh] items-end overflow-hidden">
    <img src={s.image!.src} alt={s.image!.alt ?? ""} class="absolute inset-0 -z-20 h-full w-full object-cover" loading="eager" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/75 via-black/35 to-black/10"></div>
    <div class="mx-auto w-full max-w-6xl px-5 pb-16 pt-40 md:pb-24">
      <div class="max-w-3xl text-white">
        {s.subtitle && <p class="kicker mb-4 text-base font-semibold text-white/85">{s.subtitle}</p>}
        <h1 class="text-5xl font-extrabold leading-[1.02] tracking-tight md:text-7xl">{s.title}</h1>
        {s.text && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/85 md:text-xl">{s.text}</p>}
        {(s.cta || s.ctaSecondary) && (
          <div class="mt-9 flex flex-wrap gap-3">
            {s.cta && <a href={s.cta.href} class="rounded-ui bg-accent px-7 py-3.5 font-bold text-accent-ink">{s.cta.label}</a>}
            {s.ctaSecondary && <a href={s.ctaSecondary.href} class="rounded-ui border border-white/60 px-7 py-3.5 font-bold text-white">{s.ctaSecondary.label}</a>}
          </div>
        )}
      </div>
    </div>
  </section>
) : mode === "centered" ? (
  <section class="border-b border-rule">
    <div class="mx-auto max-w-6xl px-5 pt-20 md:pt-28">
      <div class="mx-auto max-w-4xl text-center">
        {s.subtitle && <p class="kicker mb-4 text-base font-semibold text-accent">{s.subtitle}</p>}
        <h1 class="text-5xl font-extrabold leading-[1.03] tracking-tight md:text-7xl">{s.title}</h1>
        {s.text && <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft md:text-xl">{s.text}</p>}
        {(s.cta || s.ctaSecondary) && (
          <div class="mt-9 flex flex-wrap justify-center gap-3">
            {s.cta && <a href={s.cta.href} class="rounded-ui bg-accent px-7 py-3.5 font-bold text-accent-ink">{s.cta.label}</a>}
            {s.ctaSecondary && <a href={s.ctaSecondary.href} class="rounded-ui border border-rule px-7 py-3.5 font-bold">{s.ctaSecondary.label}</a>}
          </div>
        )}
      </div>
      {hasImg ? (
        <img src={s.image!.src} alt={s.image!.alt ?? ""} class="mt-14 aspect-[21/9] w-full rounded-t-ui object-cover" loading="eager" />
      ) : <div class="pb-20 md:pb-28"></div>}
    </div>
  </section>
) : (
  <section class="border-b border-rule">
    <div class:list={["mx-auto max-w-6xl px-5 py-20 md:py-28", hasImg && "grid items-center gap-12 md:grid-cols-[1.15fr_1fr]"]}>
      <div class="max-w-3xl">
        {s.subtitle && <p class="kicker mb-4 text-base font-semibold text-accent">{s.subtitle}</p>}
        <h1 class="text-4xl font-extrabold leading-[1.05] tracking-tight md:text-6xl">{s.title}</h1>
        {s.text && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft md:text-xl">{s.text}</p>}
        {(s.cta || s.ctaSecondary) && (
          <div class="mt-8 flex flex-wrap gap-3">
            {s.cta && <a href={s.cta.href} class="rounded-ui bg-accent px-6 py-3 font-bold text-accent-ink">{s.cta.label}</a>}
            {s.ctaSecondary && <a href={s.ctaSecondary.href} class="rounded-ui border border-rule px-6 py-3 font-bold">{s.ctaSecondary.label}</a>}
          </div>
        )}
      </div>
      {hasImg && (
        <img src={s.image!.src} alt={s.image!.alt ?? ""} width={s.image!.width} height={s.image!.height}
          class="aspect-[4/3] w-full rounded-ui object-cover" loading="eager" />
      )}
    </div>
  </section>
)}
