---
import type { Section } from "@/data/types";
import Section_ from "./Section.astro";
import Heading from "./Heading.astro";
type P = Extract<Section, { type: "faq" }>;
const s = Astro.props as P;
---
<Section_ narrow id="intrebari">
  <Heading title={s.title} />
  <div class="divide-y divide-rule border-y border-rule">
    {s.items.map((f) => (
      <details class="group py-4">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-bold">
          {f.q}<span aria-hidden="true" class="text-accent transition group-open:rotate-45">+</span>
        </summary>
        <p class="mt-3 leading-relaxed text-ink-soft">{f.a}</p>
      </details>
    ))}
  </div>
</Section_>
