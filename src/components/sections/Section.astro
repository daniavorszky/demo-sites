---
/* Înveliș comun: spațiere, lățime, fundal alternativ opțional. */
interface Props { alt?: boolean; id?: string; narrow?: boolean }
const { alt = false, id, narrow = false } = Astro.props;
---
<section id={id} class:list={["py-16 md:py-24", alt && "bg-bg-alt"]}>
  <div class:list={["mx-auto px-5", narrow ? "max-w-3xl" : "max-w-6xl"]}>
    <slot />
  </div>
</section>
