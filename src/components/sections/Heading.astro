---
interface Props { title?: string; intro?: string }
const { title, intro } = Astro.props;
---
{(title || intro) && (
  <div class="mb-10 max-w-2xl">
    {title && <h2 class="text-3xl font-extrabold tracking-tight md:text-4xl">{title}</h2>}
    {intro && <p class="mt-3 text-lg text-ink-soft">{intro}</p>}
  </div>
)}
